<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_blue">#00D4FF</color>
    <color name="accent_green">#00FF88</color>
    <color name="accent_orange">#FF6B35</color>
    <color name="accent_purple">#A855F7</color>
    <color name="bg_deep">#080C14</color>
    <color name="bg_display">#060A10</color>
    <color name="bg_nav">#080C14</color>
    <color name="bg_panel">#0D1220</color>
    <color name="btn_eq_bg">#FF6B35</color>
    <color name="btn_eq_pressed">#FF8C5A</color>
    <color name="btn_eq_text">#FFFFFF</color>
    <color name="btn_func_bg">#2D0808</color>
    <color name="btn_func_pressed">#4A1010</color>
    <color name="btn_func_text">#FF6B6B</color>
    <color name="btn_mem_bg">#1E0D3C</color>
    <color name="btn_mem_text">#C084FC</color>
    <color name="btn_mod_bg">#1A1A30</color>
    <color name="btn_mod_pressed">#222244</color>
    <color name="btn_mod_text">#C084FC</color>
    <color name="btn_num_bg">#111827</color>
    <color name="btn_num_pressed">#1A2535</color>
    <color name="btn_num_text">#E8F4F8</color>
    <color name="btn_op_bg">#0A2010</color>
    <color name="btn_op_pressed">#0F3018</color>
    <color name="btn_op_text">#00FF88</color>
    <color name="btn_sci_bg">#0D1F3C</color>
    <color name="btn_sci_pressed">#162D54</color>
    <color name="btn_sci_text">#7DD3FC</color>
    <color name="divider_color">#0D1F2D</color>
    <color name="mode_active_bg">#0D2535</color>
    <color name="mode_active_border">#00D4FF</color>
    <color name="mode_inactive_bg">#080C14</color>
    <color name="mode_inactive_text">#4D7A8A</color>
    <color name="text_dim">#4D7A8A</color>
    <color name="text_main">#E8F4F8</color>
    <string name="app_name">Modern Calculator</string>
    <string name="btn_acos">cos⁻¹</string>
    <string name="btn_asin">sin⁻¹</string>
    <string name="btn_atan">tan⁻¹</string>
    <string name="error">Error</string>
    <string name="infinity">∞</string>
    <string name="memory_empty">Memory is empty</string>
    <string name="memory_stored">Memory stored</string>
    <string name="no_history">— no history —</string>
    <style name="BackButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_mod_bg</item>
        <item name="android:textColor">@color/accent_purple</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="BaseCalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/accent_blue</item>
    </style>
    <style name="EqButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_eq_bg</item>
        <item name="android:textColor">@color/btn_eq_text</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:elevation">6dp</item>
    </style>
    <style name="FuncButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_func_bg</item>
        <item name="android:textColor">@color/btn_func_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="strokeColor">@color/btn_func_text</item>
        <item name="strokeWidth">0.5dp</item>
    </style>
    <style name="ModButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_mod_bg</item>
        <item name="android:textColor">@color/btn_mod_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="ModeToggleActive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">@color/accent_blue</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/accent_blue</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/mode_active_bg</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ModeToggleInactive" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">@color/mode_inactive_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/mode_inactive_text</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/mode_inactive_bg</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="NumButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_num_bg</item>
        <item name="android:textColor">@color/btn_num_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="OpButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_op_bg</item>
        <item name="android:textColor">@color/btn_op_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="strokeColor">@color/btn_op_text</item>
        <item name="strokeWidth">0.5dp</item>
    </style>
    <style name="SciButton" parent="BaseCalcButton">
        <item name="backgroundTint">@color/btn_sci_bg</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/btn_sci_text</item>
        <item name="strokeWidth">0.3dp</item>
        <item name="android:layout_margin">3dp</item>
    </style>
    <style name="SciButtonMem" parent="SciButton">
        <item name="backgroundTint">@color/btn_mem_bg</item>
        <item name="android:textColor">@color/btn_mem_text</item>
        <item name="strokeColor">@color/btn_mem_text</item>
    </style>
    <style name="Theme.ModernCalculator" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="android:windowBackground">@color/bg_panel</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="ZeroButton" parent="NumButton">
        <item name="cornerRadius">30dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">26dp</item>
    </style>
</resources>